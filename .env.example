# Encryption key for the Credential Vault (REQUIRED).
# It encrypts your GitHub token + model API key at rest. A valid key is 32 random
# bytes, URL-safe base64 encoded (a 44-character string ending in "="). Generate one
# with whichever you have — paste the output after the "=" below:
#
#   Windows PowerShell (no install needed):
#     $b=[byte[]]::new(32);([Security.Cryptography.RNGCryptoServiceProvider]::new()).GetBytes($b);[Convert]::ToBase64String($b).Replace('+','-').Replace('/','_')
#
#   macOS / Linux / Git Bash:
#     openssl rand -base64 32 | tr '+/' '-_'
#
#   Docker (works anywhere Docker runs):
#     docker run --rm python:3.12-slim python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# Keep this key stable. Rotating it makes already-stored secrets undecryptable —
# you would have to re-enter the token + API key in the Settings page.
LINGUA_SECRET_KEY=

# Agent engine: "opencode" (default, out-of-process server) | "deepagents" (in-process LangGraph).
# Switch is server-side only; the UI is identical either way.
AGENT_ENGINE=opencode
# SQLite file for deepagents' durable per-Conversation memory (default shown; lives
# on the orchestrator data volume so it survives docker compose down/up).
#DEEPAGENTS_CHECKPOINT_PATH=/app/data/deepagents-checkpoints.db

# NOTE: the GitHub token and the model connection (provider, API key, model id) are
# managed in the UI Settings page (the Credential Vault), not via environment variables.
# A fresh install routes you to Settings before any project will run.

# Optional GitHub PAT used ONLY by the workspace container to clone a PRIVATE
# AGENT_CONFIG_REPO_URL at boot. Leave blank for a public/bind-mounted agent-config.
# This is operator infrastructure auth — user GitHub auth lives in Settings.
GITHUB_TOKEN=

# Agent-config repo: holds opencode.json (prompt/skills/MCP) — the model is injected
# by Lingua from the Credential Vault, so opencode.json need not set it.
AGENT_CONFIG_REPO_URL=
AGENT_CONFIG_BRANCH=main
AGENT_CONFIG_PULL_ALWAYS=false

# Git identity used by Publish commits
GIT_USER_NAME=Lingua
GIT_USER_EMAIL=lingua@local
