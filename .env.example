OPENROUTER_API_KEY=sk-or-v1-your-key-here

# GitHub Personal Access Token (classic or fine-grained, repo scope).
# Required for cloning private bootstrap repos and pushing to target repos.
GITHUB_TOKEN=

# Bootstrap repo (read-only template source).
# Cloned into /project on first boot. Contains starter code and optionally
# .opencode/ skills, agents, MCP config. Leave blank to use the bundled
# vite-template fallback.
BOOTSTRAP_REPO_URL=

# Target repo (push destination). Where session changes get committed and pushed.
# Per-project. Can be overridden per-session via the Chainlit UI.
TARGET_REPO_URL=

# Git identity used by commits made inside the container.
GIT_USER_NAME=Lingua
GIT_USER_EMAIL=lingua@local
