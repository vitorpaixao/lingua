# OpenRouter API key for OpenCode LLM calls (required)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# GitHub Personal Access Token with `repo` scope.
# Required for cloning private bootstrap/agent-config repos and pushing via Publish.
GITHUB_TOKEN=

# Agent-config repo: holds opencode.json + skills + agents (separate from any bootstrap)
AGENT_CONFIG_REPO_URL=
AGENT_CONFIG_BRANCH=main
AGENT_CONFIG_PULL_ALWAYS=false

# Git identity used by Publish commits
GIT_USER_NAME=Lingua
GIT_USER_EMAIL=lingua@local
