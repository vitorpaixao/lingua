# OpenRouter API key for LLM calls (required).
# Used by OpenCode (workspace) and — when AGENT_ENGINE=deepagents — by the orchestrator.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Agent engine: "opencode" (default, out-of-process server) | "deepagents" (in-process LangGraph).
# Switch is server-side only; the UI is identical either way.
AGENT_ENGINE=deepagents
# OpenRouter model id used when AGENT_ENGINE=deepagents (any tool-calling model).
DEEPAGENTS_MODEL=anthropic/claude-sonnet-4.5

# GitHub Personal Access Token with `repo` scope.
# Required for cloning private bootstrap/agent-config repos and pushing via Publish.
GITHUB_TOKEN=

# Bootstrap repo (read-only template source).
# Cloned into /project on first boot. Contains starter code and optionally
# .opencode/ skills, agents, MCP config. Leave blank to use the bundled
# vite-template fallback.
BOOTSTRAP_REPO_URL=https://github.com/vitorpaixao/lingua--bootstrap

# Target repo (push destination). Where session changes get committed and pushed.
# Per-project. Can be overridden per-session via the Chainlit UI.
TARGET_REPO_URL=https://github.com/vitorpaixao/lingua--app01

# Agent-config repo: holds opencode.json + skills + agents (separate from any bootstrap)
AGENT_CONFIG_REPO_URL=
AGENT_CONFIG_BRANCH=main
AGENT_CONFIG_PULL_ALWAYS=false

# Git identity used by Publish commits
GIT_USER_NAME=Lingua
GIT_USER_EMAIL=lingua@local
